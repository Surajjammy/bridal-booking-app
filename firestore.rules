rules_version = '2';

// TARGET rules. Do not deploy until:
//   1. phone login works in the customer app, and
//   2. your own admin account exists in the `admins` collection
// otherwise customers cannot book, or you cannot sign in to the admin panel.
// See docs/firestore-schema.md.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins are the users listed in /admins/{uid}. Only the Firebase console
    // can add one: the rules below never allow client writes to that
    // collection.
    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // The artist's provider owner is allowed to manage that artist's bookings.
    // `.get(key, default)` keeps a missing field from raising an error.
    function isArtistOwner(artistId) {
      let providerId =
        get(/databases/$(database)/documents/artists/$(artistId)).data.get('providerId', '');
      return signedIn() && providerId != '' &&
        get(/databases/$(database)/documents/providers/$(providerId)).data.get('ownerUid', '') == request.auth.uid;
    }

    match /admins/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // Customer profiles: a user manages only their own document.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create, update: if signedIn() && request.auth.uid == uid;
    }

    // Business records (commission, owner). Admin only.
    match /providers/{providerId} {
      allow read, write: if isAdmin();
    }

    // Admin-only artist details (contact, notes). Never readable by customers.
    match /artistPrivate/{artistId} {
      allow read, write: if isAdmin();
    }

    // Public catalogue. Customers can only list artists that are active.
    match /artists/{artistId} {
      allow read: if isAdmin() || resource.data.isActive == true;
      allow write: if isAdmin();

      match /portfolio/{itemId} {
        allow read: if true;
        allow write: if isAdmin() || isArtistOwner(artistId);
      }
    }

    match /bookings/{bookingId} {
      allow read: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid) ||
        isArtistOwner(resource.data.artistId);

      // Customers can only create a `requested` booking for themselves.
      allow create: if signedIn() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.status == 'requested';

      // Admin or artist confirm/decline/complete; the customer may only
      // cancel. Only `status` may change.
      allow update: if signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        (
          isAdmin() ||
          (resource.data.userId == request.auth.uid &&
            request.resource.data.status == 'cancelled') ||
          (isArtistOwner(resource.data.artistId) &&
            request.resource.data.status in ['confirmed', 'declined', 'cancelled', 'completed'])
        );

      allow delete: if isAdmin();
    }

    // One document per taken artist+time. Its existence is what prevents
    // double booking; create succeeds only if it does not exist yet.
    match /bookingSlots/{slotId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if isAdmin() ||
        (signedIn() && resource.data.userId == request.auth.uid) ||
        isArtistOwner(resource.data.artistId);
      allow update: if false;
    }
  }
}
